# Copy to .env (gitignored) and fill in.
CGH_API_KEY=<team API key, same one as in .mcp.json>

# Optional
# LOOP_POLL_SECONDS=20
# LOOP_HEARTBEAT_MINUTES=15
# LOOP_STALE_MINUTES=60
# LOOP_DATA_DIR=data
# LOOP_LOG_LEVEL=INFO   # console only; log files always keep DEBUG
# OPENROUTER_API_KEY=      # live agent; without it (or with --stub) the stub agent runs
# AGENT_MODEL=anthropic/claude-sonnet-4.5   # any OpenRouter model slug (must support tool calling)
# AGENT_MAX_STEPS=12       # max LLM/tool steps per wake-up
